{
  "name": "arrowcol-routing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "crates/arrowcol-routing/src",
  "implicitDependencies": ["arrowcol-protocol", "arrowcol-sql-server", "arrowcol-infra"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/projects/arrowcol-infra/migrations/**/*"
    ]
  },
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts crates/arrowcol-routing",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package arrowcol-routing"}
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package arrowcol-routing -- --check"}
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo clippy --locked --package arrowcol-routing --all-targets -- -D warnings"}
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"command": "cargo build --locked --package arrowcol-routing"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo test --locked --package arrowcol-routing"}
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {"command": "RUSTDOCFLAGS='-D warnings' cargo doc --locked --package arrowcol-routing --no-deps"}
    },
    "live-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "crates/arrowcol-routing/scripts/live-integration.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["format-check", "lint", "build", "test", "doc"],
      "options": {"commands": []}
    }
  },
  "tags": ["scope:rust", "type:library"]
}
