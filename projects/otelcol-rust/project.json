{
  "name": "otelcol-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["otel-deltalake-exporter"],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/otelcol-rust",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo build --locked --package otelcol-rust"
      }
    },
    "config-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/otelcol-rust --validate-and-exit --config projects/otelcol-rust/config.yaml"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "target/debug/otelcol-rust --num-cores 2 --config projects/otelcol-rust/config.yaml",
        "forwardAllArgs": true
      }
    },
    "image": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/otelcol-rust-load.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/otelcol-rust",
        "tags": ["dev"],
        "platforms": ["linux/amd64"],
        "output": "load",
        "manifestFile": "{absWorkspaceRoot}/target/images/otelcol-rust-load.txt"
      },
      "configurations": {
        "ci-verify": {
          "cacheFrom": ["type=gha,version=2,scope={projectName}-image"],
          "cacheTo": ["type=gha,version=2,scope={projectName}-image,mode=max"]
        }
      }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "bash projects/otelcol-rust/scripts/image-smoke.sh",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    },
    "publish": {
      "executor": "rust-playground-build:docker-build",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/Dockerfile",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/submodules/otel-arrow/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/target/images/otelcol-rust-publish.txt"
      ],
      "options": {
        "file": "{absProjectRoot}/Dockerfile",
        "context": "{absWorkspaceRoot}",
        "image": "ghcr.io/mdrakiburrahman/rust-playground/otelcol-rust",
        "tags": ["{gitBranchTag}", "sha-{gitSha}"],
        "immutableTags": ["sha-{gitSha}"],
        "requireCleanWorktree": true,
        "buildArgs": ["VCS_REF={gitSha}"],
        "platforms": ["linux/amd64"],
        "output": "push",
        "manifestFile": "{absWorkspaceRoot}/target/images/otelcol-rust-publish.txt"
      },
      "configurations": {
        "main": {
          "tags": ["{gitBranchTag}", "sha-{gitSha}", "latest"]
        }
      }
    },
    "format": {"executor": "nx:run-commands", "options": {"command": "cargo fmt --package otelcol-rust"}},
    "format-check": {"executor": "nx:run-commands", "options": {"command": "cargo fmt --package otelcol-rust -- --check"}},
    "lint": {"executor": "nx:run-commands", "options": {"command": "cargo clippy --locked --package otelcol-rust --all-targets -- -D warnings"}},
    "test": {"executor": "nx:run-commands", "options": {"command": "cargo test --locked --package otelcol-rust"}},
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["config-check", "format-check", "lint", "test"],
      "options": {"commands": []}
    }
  },
  "tags": ["scope:rust", "type:application", "type:runtime-image"]
}
