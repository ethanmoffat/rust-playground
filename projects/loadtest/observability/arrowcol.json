{
  "uid": "arrowcol",
  "title": "ArrowCol: direct vs dataflow",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rows ingested / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_direct_received_rows_total[30s])",
          "legendFormat": "direct"
        },
        {
          "refId": "B",
          "expr": "rate(arrowcol_received_rows_total[30s])",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rows exported / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_direct_exported_rows_total[30s])",
          "legendFormat": "direct"
        },
        {
          "refId": "B",
          "expr": "rate(arrowcol_delta_rows_total[30s])",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"direct-1\"}[30s]))",
          "legendFormat": "direct"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"dataflow-1\"}[30s]))",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(container_memory_working_set_bytes{container_label_com_docker_compose_service=\"direct-1\"})",
          "legendFormat": "direct"
        },
        {
          "refId": "B",
          "expr": "max(container_memory_working_set_bytes{container_label_com_docker_compose_service=\"dataflow-1\"})",
          "legendFormat": "dataflow"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Quiver backlog (on disk, not yet in Delta; --quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_direct_quiver_backlog_bundles",
          "legendFormat": "direct batches"
        },
        {
          "refId": "B",
          "expr": "arrowcol_dataflow_durable_backlog_batches",
          "legendFormat": "dataflow batches"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Quiver disk (--quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_direct_quiver_disk_used_bytes",
          "legendFormat": "direct WAL + segments"
        },
        {
          "refId": "B",
          "expr": "arrowcol_dataflow_durable_backlog_bytes",
          "legendFormat": "dataflow backlog"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Quiver persisted vs drained to Delta / s (--quiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arrowcol_direct_quiver_persisted_bundles_total[30s])",
          "legendFormat": "direct persisted"
        },
        {
          "refId": "B",
          "expr": "rate(arrowcol_direct_quiver_published_bundles_total[30s])",
          "legendFormat": "direct drained"
        },
        {
          "refId": "C",
          "expr": "rate(arrowcol_dataflow_durable_admitted_batches_total[30s])",
          "legendFormat": "dataflow persisted"
        },
        {
          "refId": "D",
          "expr": "rate(arrowcol_dataflow_durable_released_batches_total[30s])",
          "legendFormat": "dataflow drained"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replayed from Quiver after a crash (--crash-after)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arrowcol_direct_quiver_recovered_bundles_total",
          "legendFormat": "direct batches"
        },
        {
          "refId": "B",
          "expr": "arrowcol_direct_quiver_adopted_receipts_total",
          "legendFormat": "direct receipts adopted"
        },
        {
          "refId": "C",
          "expr": "arrowcol_dataflow_replayed_batches_total",
          "legendFormat": "dataflow replay attempts"
        },
        {
          "refId": "D",
          "expr": "arrowcol_dataflow_rebound_batches_total",
          "legendFormat": "dataflow lease rebinds"
        }
      ]
    }
  ]
}
