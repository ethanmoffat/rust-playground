{
  "name": "loadtest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "otelcol-rust",
    "arrowcol-rust",
    "arrowcol-dataflow-rust",
    "arrowcol-router-rust",
    "arrowcol-infra",
    "arrowcol-sdk-gen",
    "hello-world"
  ],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx tools/scripts/src/clean.ts projects/loadtest",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      },
      "metadata": {
        "description": "Remove local onelake demo/E2E output and project temporary state; stop running workloads first."
      }
    },
    "reader-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "projects/loadtest/scripts/build-reader-bundle.sh"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package delta-inspect --package arrowcol-loadgen"}
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {"command": "cargo fmt --package delta-inspect --package arrowcol-loadgen -- --check"}
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy --locked --package delta-inspect --all-targets -- -D warnings",
          "cargo clippy --locked --package arrowcol-loadgen --all-targets -- -D warnings"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo test --locked --package delta-inspect",
          "cargo test --locked --package arrowcol-loadgen",
          "npx --no-install tsx --test projects/loadtest/test/*.test.ts"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {"command": "npx --no-install tsc --project projects/loadtest/tsconfig.json"}
    },
    "compose-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx --no-install tsx projects/loadtest/src/compose-check.ts",
        "forwardAllArgs": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "otelcol-rust",
            "arrowcol-rust",
            "arrowcol-dataflow-rust",
            "arrowcol-router-rust",
            "hello-world"
          ],
          "target": "image"
        },
        "reader-build"
      ],
      "options": {"commands": []}
    },
    "up": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts up", "forwardAllArgs": false}
    },
    "down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts down", "forwardAllArgs": false}
    },
    "logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts logs", "forwardAllArgs": false}
    },
    "inspect": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["reader-build"],
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts inspect", "forwardAllArgs": false}
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts e2e", "forwardAllArgs": false}
    },
    "otel-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {"command": "npx --no-install tsx projects/loadtest/src/main.ts otel-e2e", "forwardAllArgs": false}
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "npx --no-install tsx projects/loadtest/src/main.ts benchmark",
        "forwardAllArgs": true
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "npx --no-install tsx projects/loadtest/src/main.ts run",
        "forwardAllArgs": true
      }
    },
    "chaos": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "npx --no-install tsx projects/loadtest/src/main.ts chaos",
        "forwardAllArgs": true
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["format-check", "lint", "typecheck", "compose-check", "test", "e2e"],
      "options": {"commands": []}
    }
  },
  "tags": ["scope:rust", "type:e2e"]
}
